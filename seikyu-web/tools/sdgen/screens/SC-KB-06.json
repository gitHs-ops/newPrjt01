{
 "views": [
  {
   "id": "SC-KB-06",
   "name": "一覧画面",
   "steps": [
    {
     "go": "#kb-import"
    },
    {
     "extract": {
      "area": "〔請求システムから受入〕",
      "root": "#content .grid2 > section:nth-of-type(1) .filters",
      "mode": "controls"
     }
    },
    {
     "extract": {
      "area": "〔CSV受入（汎用・借貸併記）〕",
      "root": "#content .grid2 > section:nth-of-type(2) .filters",
      "mode": "controls"
     }
    },
    {
     "extract": {
      "area": "〔仕訳データ書出〕",
      "root": "#content .grid2 > section:nth-of-type(3) .filters",
      "mode": "controls"
     }
    },
    {
     "search": true
    },
    {
     "extract": {
      "area": "〔受入履歴〕",
      "root": "#content .grid2 > section:nth-of-type(4) table",
      "mode": "thead"
     }
    }
   ]
  },
  {
   "id": "SC-KB-06-D1",
   "name": "詳細画面（確認「受入の取消」）",
   "steps": [
    {
     "go": "#kb-import"
    },
    {
     "search": true
    },
    {
     "click": "#content [data-act=cancel]"
    },
    {
     "extract": {
      "area": "〔確認メッセージ〕",
      "root": "dialog[open] .modal-body",
      "mode": "message"
     }
    },
    {
     "escape": true
    }
   ]
  }
 ]
}
