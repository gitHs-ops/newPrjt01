     }
    },
    {
     "extract": {
      "area": "〔配合計算モーダル・製品別配合表〕",
      "root": "dialog[open] .modal-body > h3:first-of-type",
      "mode": "message"
     }
    },
    {
     "extract": {
      "area": "〔入力フォーム（経費単価）〕",
      "root": "dialog[open] .modal-body .form-grid",
      "mode": "fields"
     }
    },
    {
     "escape": true
    }
   ]
  }
 ]
}
