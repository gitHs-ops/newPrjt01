{
 "views": [
  {
   "id": "SC-STK-02",
   "name": "指示画面",
   "steps": [
    {
     "go": "#inventory/reports"
    },
    {
     "extract": {
      "area": "〔出力条件（在庫登録リスト）〕",
      "root": "#content div[data-sub=reports]:has(#ir-month)",
      "mode": "controls",
      "buttons": true
     }
    },
    {
     "extract": {
      "area": "〔出力条件（配合計算・材料受払表）〕",
      "root": "#content div[data-sub=reports]:has(#mi-month)",
      "mode": "controls",
      "buttons": true
     }
    }
   ]
  },
  {
   "id": "SC-STK-02-D1",
   "name": "詳細画面（配合計算モーダル）",
   "steps": [
    {
     "go": "#inventory/reports"
    },
    {
     "click": "#content button[data-act=mix]"
    },
    {
     "extract": {
      "area": "〔配合計算モーダル・製品別配合表〕",
      "root": "dialog[open] .modal-body > p.note",
