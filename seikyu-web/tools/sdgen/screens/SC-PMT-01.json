    {"extract": {"area": "〔検索条件〕", "root": "#content .page-head .filters", "mode": "controls"}},
    {"go": "#payments/list?month=2026-10"},
    {"search": true},
    {"extract": {"area": "〔一覧〕", "root": "#content [data-sub=list] table", "mode": "thead"}}
   ]
  },
  {
   "id": "SC-PMT-01-D1",
   "name": "詳細画面（支払の登録モーダル）",
   "steps": [
    {"go": "#payments/list?month=2026-10"},
    {"search": true},
    {"click": "#content button[data-act=new]"},
    {"extract": {"area": "〔入力フォーム（支払の登録）〕", "root": "dialog[open] .form-grid", "mode": "fields"}},
    {"extract": {"area": "〔入力フォーム（支払の登録）〕", "root": "dialog[open] #py-payee", "mode": "message"}},
    {"set": ["#modal-form select[name=vendor]", "V003"]},
    {"click": "#modal-title"},
    {"extract": {"area": "〔入力フォーム（支払の登録）・支払対象の定時請求〕", "root": "#py-open", "mode": "linegrid"}},
    {"escape": true}
   ]
  },
  {
   "id": "SC-PMT-01-D2",
   "name": "詳細画面（確認「支払の取消」）",
   "steps": [
    {"go": "#payments/list?month=2026-10"},
    {"search": true},
    {"click": "#content button[data-act=rev]"},
    {"extract": {"area": "〔確認モーダル〕", "root": "dialog[open] #modal-body", "mode": "message"}},
    {"escape": true}
   ]
  }
 ]
